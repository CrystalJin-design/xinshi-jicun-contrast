# Local Node/SQLite development server (cloud production uses Supabase).
PORT=8790
HOST=0.0.0.0
NODE_ENV=production
# PUBLIC_ORIGIN=https://your-domain.example
# DATA_DIR=/persistent/jianji-data

# .env.production.local: only PUBLIC settings are allowed in VITE_ variables.
# VITE_API_URL=https://your-project.supabase.co/functions/v1/jianji
# VITE_SUPABASE_PUBLISHABLE_KEY=your-public-anon-or-publishable-key
# VITE_BASE_PATH=/xinshi-jicun-contrast/

# .env.admin.local: local cloud password management, NEVER publish these values.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
