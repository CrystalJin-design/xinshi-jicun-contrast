{
  "name": "jianji-assessment-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"node --watch server/index.js\" \"vite --host 0.0.0.0\"",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "edge:prepare": "node scripts/prepare-edge.js",
    "cloud:codes": "node scripts/cloud-codes.js",
    "codes:create": "node scripts/codes.js create",
    "codes:list": "node scripts/codes.js list",
    "codes:revoke": "node scripts/codes.js revoke"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@fontsource-variable/noto-serif-sc": "^5.3.1",
    "express": "^5.3.0",
    "html2canvas": "^1.4.1",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.58.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "supabase": "^2.120.0",
    "vite": "^8.3.4"
  }
}
